# PostgreSQL
DATABASE_URL="postgresql://root:password@127.0.0.1:5433/tu_lan_smart?schema=public"

# Server
PORT=3000
NODE_ENV=development
API_PUBLIC_URL=http://localhost:3000

# AI Service (FastAPI)
AI_SERVICE_URL=http://127.0.0.1:8000

# Zalo Mini App (lấy từ Zalo Developers Console)
# Khi có đủ 2 biến này, backend xác thực access token qua Zalo Open API
ZALO_APP_ID=
ZALO_APP_SECRET=

# Cho phép xác thực dev qua header x-zalo-id (chỉ dùng local/staging)
ZALO_AUTH_DEV_MODE=true

# Upload
UPLOAD_DIR=uploads

# Admin JWT
JWT_SECRET=change-me-in-production
