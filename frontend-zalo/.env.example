# ==== Cấu hình môi trường Zalo Mini App dịch vụ công ====

# URL gốc của backend API (bắt buộc khi chạy với dữ liệu thật)
VITE_BASE_URL=http://localhost:8090

# Mini App ID do Zalo cấp
VITE_MINI_APP_ID=your-zalo-mini-app-id

# Bật/tắt dữ liệu mock.
#  - "true"  : dùng dữ liệu mock (demo, không cần backend)
#  - "false" : gọi API thật theo VITE_BASE_URL
VITE_USE_MOCK=true

# (Tuỳ chọn) Token tĩnh cho môi trường dev nội bộ. KHÔNG dùng ở production.
VITE_DEV_TOKEN=
